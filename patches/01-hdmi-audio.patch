+++ b/internal/audio/volume_test.go
@@ -0,0 +1,30 @@
+package audio
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestApplyCaptureVolume(t *testing.T) {
+	tests := []struct {
+		name    string
+		percent int
+		want    []int16
+	}{
+		{"mute", 0, []int16{0, 0, 0, 0}},
+		{"half", 50, []int16{5000, -5000, 15000, -15000}},
+		{"unchanged", 100, []int16{10000, -10000, 30000, -30000}},
+		{"boost", 150, []int16{15000, -15000, 32767, -32768}},
+		{"max", 200, []int16{20000, -20000, 32767, -32768}},
+		{"clamped", 300, []int16{20000, -20000, 32767, -32768}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := []int16{10000, -10000, 30000, -30000}
+			applyCaptureVolume(got, tt.percent)
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("got %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
