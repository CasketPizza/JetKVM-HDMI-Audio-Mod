--- /dev/null
+++ b/internal/audio/volume.go
@@ -0,0 +1,27 @@
+package audio
+
+// applyCaptureVolume adjusts the unencoded signed 16-bit PCM before it is
+// downmixed and encoded for WebRTC. Values above 100% amplify, saturating
+// instead of wrapping when the signal would exceed the PCM range.
+func applyCaptureVolume(pcm []int16, percent int) {
+	if percent == 100 {
+		return
+	}
+	if percent <= 0 {
+		clear(pcm)
+		return
+	}
+	if percent > 200 {
+		percent = 200
+	}
+
+	for i, sample := range pcm {
+		amplified := int32(sample) * int32(percent) / 100
+		if amplified > 32767 {
+			amplified = 32767
+		} else if amplified < -32768 {
+			amplified = -32768
+		}
+		pcm[i] = int16(amplified)
+	}
+}
