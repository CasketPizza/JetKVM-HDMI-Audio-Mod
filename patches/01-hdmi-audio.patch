diff --git a/ui/src/utils/browserAudioVolume.ts b/ui/src/utils/browserAudioVolume.ts
new file mode 100644
index 0000000..e0dec25
--- /dev/null
+++ b/ui/src/utils/browserAudioVolume.ts
@@ -0,0 +1,24 @@
+export const browserAudioVolumeKey = "jetkvm-browser-audio-volume";
+export const browserAudioVolumeEvent = "jetkvm-browser-audio-volume-change";
+
+export function readBrowserAudioVolume(): number {
+  if (typeof window === "undefined") return 100;
+  try {
+    const stored = window.localStorage.getItem(browserAudioVolumeKey);
+    if (stored === null) return 100;
+    const value = Number(stored);
+    return Number.isFinite(value) ? Math.max(0, Math.min(200, value)) : 100;
+  } catch {
+    return 100;
+  }
+}
+
+export function writeBrowserAudioVolume(percent: number): void {
+  const value = Math.max(0, Math.min(200, Math.round(percent)));
+  try {
+    window.localStorage.setItem(browserAudioVolumeKey, String(value));
+  } catch {
+    // The slider still works for this tab when storage is unavailable.
+  }
+  window.dispatchEvent(new CustomEvent<number>(browserAudioVolumeEvent, { detail: value }));
+}
